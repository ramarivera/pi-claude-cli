{
  "name": "@ramarivera/pi-claude-cli",
  "version": "0.4.0",
  "description": "Pi and Oh My Pi extension with a shared Claude core and selectable CLI or official Agent SDK transport",
  "main": "index.ts",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ramarivera/pi-claude-cli"
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@oh-my-pi/pi-ai": "18.4.4",
    "@oh-my-pi/pi-coding-agent": "18.4.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@eslint/js": "^9.39.4",
    "@oh-my-pi/pi-ai": "18.4.4",
    "@oh-my-pi/pi-coding-agent": "18.4.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:offline": "vitest run --reporter=dot",
    "test:live": "node tests/run-live.mjs",
    "test:contracts": "vitest run tests/contracts tests/conformance --reporter=dot",
    "verify:plan": "node openspec/changes/modernize-claude-runtime/sync-beads.mjs",
    "typecheck:pi": "tsc --noEmit -p tsconfig.pi.json",
    "typecheck:omp": "tsc --noEmit -p tsconfig.omp.json"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "entrypoints/omp.ts"
    ]
  },
  "exports": {
    ".": "./index.ts",
    "./pi": "./entrypoints/pi.ts",
    "./omp": "./entrypoints/omp.ts",
    "./core": "./src/core/index.ts",
    "./cli": "./src/drivers/cli/index.ts",
    "./sdk": "./src/drivers/sdk/index.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "files": [
    "index.ts",
    "entrypoints",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
